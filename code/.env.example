# ========================================================
# REV.PERAKIT.AI — Environment Configuration Template
# (₹0-MODE: 100% Free Tier Supported)
# Copy this file to `.env` in the `code/` directory.
# ========================================================

# 1. Deepgram (Real-time Speech-to-Text Nova-2)
# Free: console.deepgram.com (gives $200 free credits on signup, no credit card required)
DEEPGRAM_API_KEY=your_deepgram_api_key_here

# 2. LLM Engine Provider (groq | gemini | mesh)
# - 'groq': Ultra-low latency (<200ms TTFT) free dev tier
# - 'gemini': Google Gemini 2.5/3.1 Flash with Vision
# - 'mesh': Multi-AI Zero-Downtime Fallback Mesh (Groq -> Gemini -> Cerebras -> OpenRouter)
LLM_PROVIDER=mesh

# Primary Fast LLM (Groq) — Free at console.groq.com
GROQ_API_KEY=gsk_your_groq_key_here

# Multimodal & Vision LLM (Google Gemini) — Free at aistudio.google.com
# Required for LeetCode / Coding Screen Snip (Ctrl+Alt+S) & Fallback Mesh
GEMINI_API_KEY=your_gemini_api_key_here

# Mesh Fallback Engines (Optional)
CEREBRAS_API_KEY=
OPENROUTER_API_KEY=

# 3. Realtime Gateway WebSocket Port
GATEWAY_PORT=8080

# 4. Payments Configuration (Razorpay & Direct UPI)
# Razorpay: dashboard.razorpay.com -> Settings -> API Keys
NEXT_PUBLIC_RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=

# Direct UPI VPA for Instant QR Payments (Zero Gateway Commission)
NEXT_PUBLIC_UPI_VPA=ahmadkhankhan6840-1@okaxis

# 5. Database (Optional SQLite / Postgres)
DATABASE_URL="file:./dev.db"
